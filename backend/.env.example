# --- Local Postgres (Docker) ---
POSTGRES_USER=nexum
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nexum_dev

# --- Connection string the app uses ---
DATABASE_URL="postgresql://nexum:change_me@localhost:5433/nexum_dev?schema=public"

# --- App config ---
JWT_SECRET="generate-with-openssl-rand-base64-32"
PORT=4000
# Browser origin allowed to call this API. Local Vite: http://localhost:5173
# Production: set this on the API host to the Vercel URL (required; missing = CORS closed).
CORS_ORIGIN="http://localhost:5173"
