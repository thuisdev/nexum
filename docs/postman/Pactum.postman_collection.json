        {
          "name": "Fund Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Project IN_PROGRESS', () => pm.expect(body.status).to.eql('IN_PROGRESS'));",
                  "pm.test('Escrow FUNDED', () => pm.expect(body.escrowStatus).to.eql('FUNDED'));",
                  "pm.test('fundedAt set', () => pm.expect(body.fundedAt).to.be.a('string'));",
                  "pm.test('Milestone 0 IN_PROGRESS', () => {",
                  "  const m0 = body.milestones.find(m => m.orderIndex === 0);",
                  "  pm.expect(m0.status).to.eql('IN_PROGRESS');",
                  "});"
                ]
              }
            }
          ],
